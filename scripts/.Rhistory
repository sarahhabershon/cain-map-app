library(httr)
library(jsonlite)
library(dplyr)
address <- "bc1qxx2untk3y2zvgd5kvs3nw4mlcpv06azg2envh8"
url <- paste0("https://blockchain.info/rawaddr/", address)
res <- GET(url)
data <- fromJSON(content(res, "text", encoding = "UTF-8"))
txs <- data$txs
df <- data.frame(
tx_hash = txs$hash,
time = as.POSIXct(txs$time, origin="1970-01-01"),
block_height = txs$block_height,
fee = txs$fee,
input_value = sapply(txs$inputs, function(x) sum(sapply(x$prev_out$value, identity))),
output_value = sapply(txs$out, function(x) sum(x$value))
)
print(df)
glimpse(df)
library(httr)
library(jsonlite)
library(dplyr)
address <- "bc1qxx2untk3y2zvgd5kvs3nw4mlcpv06azg2envh8"
# ---------
# 1. Download all transactions
# ---------
all_txs <- list()
offset <- 0
repeat {
url <- paste0("https://blockchain.info/rawaddr/", address, "?offset=", offset)
res <- GET(url)
data <- fromJSON(content(res, "text", encoding="UTF-8"))
if(length(data$txs) == 0) break
all_txs[[length(all_txs)+1]] <- data$txs
offset <- offset + 50
}
txs <- bind_rows(all_txs)
# ---------
# 2. Build dataframe
# ---------
df <- data.frame(
tx_hash = txs$hash,
time = as.POSIXct(txs$time, origin="1970-01-01"),
block_height = txs$block_height,
fee = txs$fee,
output_sats = sapply(txs$out, function(x) sum(x$value))
)
# convert to BTC
df$btc_value <- df$output_sats / 1e8
# ---------
# 3. Function to get historical BTC price
# ---------
get_btc_price <- function(date){
date_str <- format(date, "%d-%m-%Y")
url <- paste0(
"https://api.coingecko.com/api/v3/coins/bitcoin/history?date=",
date_str
)
res <- GET(url)
if(status_code(res) != 200){
return(NA)
}
data <- fromJSON(content(res, "text", encoding="UTF-8"))
price <- data$market_data$current_price$usd
return(price)
}
# ---------
# 4. Get BTC price per unique date
# ---------
df$date <- as.Date(df$time)
unique_dates <- unique(df$date)
price_lookup <- data.frame(
date = unique_dates,
btc_usd = sapply(unique_dates, get_btc_price)
)
# ---------
# 5. Merge price + compute USD value
# ---------
df <- left_join(df, price_lookup, by="date")
df$usd_value <- df$btc_value * df$btc_usd
# ---------
# Final dataframe
# ---------
print(df)
