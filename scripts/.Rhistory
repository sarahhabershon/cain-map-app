library(tidyverse)
# Build interaction counts (normalise so order doesn't matter)
interactions <- all_events_filtered %>%
mutate(
group_a = actor_group_a_reduced,
group_b = actor_group_b_reduced
) %>%
filter(!is.na(group_a), !is.na(group_b)) %>%
# Normalise typos
mutate(across(c(group_a, group_b), ~case_when(
. %in% c("Othes", "Othre", "Others") ~ "Other",
TRUE ~ .
))) %>%
# Count both directions as the same interaction
mutate(
grp1 = pmin(group_a, group_b),
grp2 = pmax(group_a, group_b)
) %>%
count(grp1, grp2, name = "events")
# For a full symmetric matrix, duplicate with axes flipped
matrix_data <- bind_rows(
interactions,
interactions %>% rename(grp1 = grp2, grp2 = grp1)
)
ggplot(matrix_data, aes(x = grp1, y = grp2, fill = events)) +
geom_tile(colour = "white", linewidth = 0.5) +
geom_text(aes(label = events), size = 3, colour = "white", fontface = "bold") +
scale_fill_gradient(low = "#fdae2a", high = "#d87355", na.value = "grey90") +
labs(
title = "Actor Group Interactions",
subtitle = "Number of events involving each pair of groups",
x = NULL, y = NULL,
fill = "Events"
) +
theme_minimal(base_size = 12) +
theme(
axis.text.x = element_text(angle = 45, hjust = 1),
panel.grid = element_blank(),
plot.title = element_text(face = "bold")
)
ggplot(interactions, aes(x = grp1, y = grp2, fill = events)) +
geom_tile(colour = "white", linewidth = 0.5) +
geom_text(aes(label = events), size = 3, colour = "white", fontface = "bold") +
scale_fill_gradient(low = "#fdae2a", high = "#d87355", na.value = "grey90") +
labs(
title = "Actor Group Interactions",
