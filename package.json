{
	"name": "italy-app",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"build:static": "STATIC_BUILD=true vite build",
		"deploy": "npm run build:static && git add build && git commit -m 'Update static site' || true && git push origin $(git subtree split --prefix build):refs/heads/gh-pages --force",
		"prepare": "svelte-kit sync || echo ''",
		"format": "prettier --write .",
		"lint": "prettier --check . && eslint ."
	},
	"devDependencies": {
		"@eslint/compat": "^1.2.5",
		"@eslint/js": "^9.18.0",
		"@sveltejs/adapter-auto": "^4.0.0",
		"@sveltejs/kit": "^2.16.0",
		"@sveltejs/vite-plugin-svelte": "^5.0.0",
		"eslint": "^9.18.0",
		"eslint-config-prettier": "^10.0.1",
		"eslint-plugin-svelte": "^3.0.0",
		"globals": "^16.0.0",
		"prettier": "^3.4.2",
		"prettier-plugin-svelte": "^3.3.3",
		"svelte": "^5.0.0",
		"vite": "^6.0.0"
	},
	"dependencies": {
		"@sveltejs/adapter-static": "^3.0.10",
		"d3": "^7.9.0",
		"html2canvas": "^1.4.1",
		"jspdf": "^4.0.0",
		"l": "^0.6.0",
		"maplibre-gl": "^5.7.1",
		"papaparse": "^5.5.3",
		"sv": "^0.9.4",
		"svelte-maplibre": "^1.2.5"
	}
}
